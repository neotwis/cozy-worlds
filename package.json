{
  "name": "cozy-world",
  "version": "1.0.0",
  "description": "Deterministic, seed-based cozy world generator: terrain, biomes, weather, creatures, loot and events.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
